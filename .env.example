# Aplicação
NODE_ENV=development
PORT=4002
HOST=0.0.0.0
APP_VERSION=0.1.0

# Supabase PostgreSQL — runtime usa conexão persistente/Supavisor Session Pooler.
# DATABASE_URL é alias temporário para desenvolvimento.
DB_PROVIDER=supabase
DATABASE_URL_RUNTIME=
DATABASE_URL_MIGRATIONS=
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5433/mavo_talk
PG_SSL=false
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_APPLICATION_NAME=mavo-talk-api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEFAULT_ORG_ID=org_mavo_talk_default
JWT_SECRET=
SESSION_COOKIE_NAME=mavo_talk_session
SESSION_COOKIE_SAME_SITE=lax
# Sincronizacao completa de historico do WhatsApp. Necessaria para o WhatsApp
# entregar a agenda inteira do aparelho, mas consome bem mais memoria.
WHATSAPP_SYNC_FULL_HISTORY=false
FRONTEND_URL=http://localhost:4001
MAVO_API_PUBLIC_URL=http://localhost:4002
ALLOWED_ORIGINS=http://localhost:4001
MAVO_ALLOWED_ORIGINS=http://localhost:4001
LOG_LEVEL=info

# Render Key Value / Redis
REDIS_URL=
MAVO_QUEUE_ENV=development
# true roda os workers BullMQ dentro do processo web. Necessário no plano
# gratuito do Render, que não oferece Background Worker.
MAVO_INLINE_WORKER=false
WORKER_CONCURRENCY=5

# Painel master /mavo — use secrets do Render em produção
MAVO_MASTER_EMAIL=admin@empresa.com
MAVO_MASTER_PASSWORD=troque-por-uma-senha-forte
MAVO_MASTER_NAME=Administrador Mavo
# Opcional: hash bcrypt substitui MAVO_MASTER_PASSWORD
# MAVO_MASTER_PASSWORD_HASH=$2b$12$...

# WhatsApp: unofficial (QR Code via Baileys) ou twilio
WHATSAPP_PROVIDER=unofficial
WHATSAPP_SESSION_NAME=mavo-talk
# database persiste a sessão cifrada no Supabase; filesystem exige disco.
WHATSAPP_AUTH_STORE=database
# Opcional, mas recomendado para permitir rotação independente do JWT.
# Gere com: openssl rand -base64 48. Sem ela, uma subchave é derivada do
# JWT_SECRET forte; nunca remova uma chave dedicada depois de iniciar a sessão.
WHATSAPP_AUTH_ENCRYPTION_KEY=
WHATSAPP_AUTH_PATH=.whatsapp_auth
WHATSAPP_AUTO_CONNECT=true
RENDER_DISK_PATH=
# Usado somente com WHATSAPP_AUTH_STORE=filesystem no Render sem disco.
WHATSAPP_ALLOW_EPHEMERAL_SESSION=false
WILLTALK_WEBHOOK_TOKEN=
WILLTALK_WEBHOOK_ORGANIZATION_ID=
# JSON opcional para webhooks legados multi-tenant. Prefira credenciais externas
# por tenant e nunca exponha este valor no frontend.
WILLTALK_WEBHOOK_TENANT_TOKENS_JSON=
WILLTALK_AI_TRIAGE_ONLY=true
WILLTALK_N8N_ONLY=false
WILLTALK_AUTO_REPLY_ENABLED=true

# Camada gerencial e agente cloud
MAVO_BUSINESS_ANALYTICS_ENABLED=true
MAVO_BUSINESS_ACCESS_ENABLED=true
MAVO_AGENT_API_ENABLED=true
MAVO_MCP_ENABLED=false
MAVO_MCP_ORGANIZATION_ID=
MAVO_MCP_ACCESS_USER_ID=
MAVO_AGENT_CLOCK_TOLERANCE_SECONDS=300
MAVO_AGENT_MAX_PAYLOAD_BYTES=1048576
MAVO_AGENT_RATE_LIMIT_PER_MINUTE=60
MAVO_AGENT_NEXT_SYNC_SECONDS=300
# 32 bytes em base64. Gere com: openssl rand -base64 32
MAVO_AGENT_CREDENTIAL_ENCRYPTION_KEY=
MAVO_SIM_API_BASE_URL=http://localhost:4002
MAVO_SIM_AGENT_ID=
MAVO_SIM_AGENT_SECRET=
MAVO_SIM_REVOKED_AGENT_ID=
MAVO_BUSINESS_SESSION_TTL_MINUTES=15
MAVO_BUSINESS_PIN_MAX_ATTEMPTS=5
MAVO_BUSINESS_PIN_LOCK_MINUTES=15
MAVO_BUSINESS_QUERY_RATE_LIMIT_PER_MINUTE=30
MAVO_DEFAULT_TIMEZONE=America/Sao_Paulo
MAVO_DEFAULT_CURRENCY=BRL

# Bot de supermercado Mavo
SUPERMARKET_BOT_ENABLED=true
SUPERMARKET_AUTO_APPLY_PRESET=true
SUPERMARKET_BOT_NAME=Mavo
SUPERMARKET_NAME=Supermercado Exemplo
SUPERMARKET_ADDRESS=Rua Exemplo, 123 - Centro
SUPERMARKET_MAPS_URL=https://maps.google.com/?q=Rua+Exemplo+123
SUPERMARKET_HOURS_WEEKDAYS=Segunda a sábado: 07h às 21h
SUPERMARKET_HOURS_SUNDAY=Domingos e feriados: 08h às 14h
SUPERMARKET_OFFERS_URL=https://seu-supermercado.com.br/ofertas
SUPERMARKET_OFFERS_TEXT=Ofertas do dia disponíveis no nosso encarte.
SUPERMARKET_OFFERS_IMAGE_URL=
SUPERMARKET_OFFERS_IMAGE_PUBLIC_ID=
SUPERMARKET_PHONE=(11) 3333-4444

# Horário usado pela automação para decidir se a loja está aberta. O cadastro
# no banco por organização tem prioridade sobre estes valores.
BUSINESS_HOURS_WEEKDAY_START=07:00
BUSINESS_HOURS_WEEKDAY_END=21:00
BUSINESS_HOURS_WEEKDAY_CLOSED=false
BUSINESS_HOURS_SATURDAY_START=07:00
BUSINESS_HOURS_SATURDAY_END=21:00
BUSINESS_HOURS_SATURDAY_CLOSED=false
BUSINESS_HOURS_SUNDAY_START=08:00
BUSINESS_HOURS_SUNDAY_END=14:00
BUSINESS_HOURS_SUNDAY_CLOSED=false

# false mantém respostas desconhecidas no menu seguro do Mavo.
# true permite encaminhar mensagens desconhecidas ao fallback de IA/Cérebro.
SUPERMARKET_AI_FALLBACK_ENABLED=false

# Segurança para testes: persiste a resposta, mas não envia ao WhatsApp.
WILLTALK_DRY_RUN_WHATSAPP=true

# Mavo AI / Cérebro Operacional (somente backend)
MAVO_AI_BASE_URL=
MAVO_AI_TOKEN=
# Aliases legados mantidos temporariamente
WILLTALK_CEREBRO_INGEST_URL=
WILLTALK_CEREBRO_REPLY_URL=
WILLTALK_CEREBRO_ORCHESTRATOR_URL=
WILLTALK_CEREBRO_TOKEN=

# Twilio opcional: provider primario se WHATSAPP_PROVIDER=twilio, ou fallback
# automatico quando o WhatsApp unofficial (Baileys) nao esta pronto.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_BASE_URL=

# Cloudinary (somente backend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
